<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
<ImageView android:layout_width="64dp" android:layout_height="64dp" android:contentDescription="@string/app_name" android:src="@drawable/cpns_juara_logo"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CPNS JUARA" android:textColor="@color/navy" android:textSize="28sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/brand_descriptor" android:textColor="@color/muted" android:textSize="12sp" android:textStyle="bold"/></LinearLayout>
<TextView android:id="@+id/txtPremiumBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FREE" android:textColor="@color/gold" android:textStyle="bold"/>
</LinearLayout>
<TextView android:id="@+id/txtAccount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Mode Tamu" android:textColor="@color/teal" android:textStyle="bold"/>
<TextView android:id="@+id/txtLocalCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:padding="18dp" android:text="Soal offline: 0" android:textColor="@color/text" android:textSize="17sp" android:textStyle="bold"/>
<Button android:id="@+id/btnPackages" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Download / Update Bank Soal"/>
<Button android:id="@+id/btnTWK" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Latihan TWK"/><Button android:id="@+id/btnTIU" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Latihan TIU"/><Button android:id="@+id/btnTKP" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Latihan TKP"/>
<Button android:id="@+id/btnQuickTest" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quick Test 5 / 10 / 20"/><Button android:id="@+id/btnWrong" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Soal Salah Saya"/><Button android:id="@+id/btnSaved" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Soal Tersimpan"/><Button android:id="@+id/btnCat" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Simulasi CAT"/><Button android:id="@+id/btnRanking" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ranking"/><Button android:id="@+id/btnPremium" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🏆 Upgrade Premium"/>
<Button android:id="@+id/btnStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Statistik"/><Button android:id="@+id/btnProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Profil / Akun"/><Button android:id="@+id/btnSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pengaturan Server"/>
<FrameLayout android:id="@+id/bannerContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"/>
</LinearLayout></ScrollView>